{
  "name": "fbar-max-balance-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev --turbopack",
    "build": "npm run tailwind && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "//test": "--disable-warning=DEP0040 suppresses the DEP0040 punycode deprecation warning emitted by transitive dependencies (tr46 via jsdom, uri-js via eslint). The punycode built-in was deprecated in Node 16 and removed in Node 22; the npm punycode package is still installed but Node intercepts the require call and warns regardless.",
    "test": "NODE_OPTIONS='--disable-warning=DEP0040' vitest --run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tailwind": "tailwindcss -i css/input.css -o css/output.css",
    "tailwind:watch": "npm run tailwind -- --watch",
    "design-system:test": "playwright test --config=playwright.config.ts",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "seed-test-data": "ts-node test-data/scripts/seed-test-data.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ynab": "^4.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@tailwindcss/cli": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-storybook": "^10.4.6",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "uuid": "^14.0.1",
    "vitest": "^4.1.9"
  }
}
